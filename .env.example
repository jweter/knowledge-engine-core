# Copy this file to .env for local development.
# Never commit real credentials. .env and .env.* are ignored by Git.

# Optional hosted model access.
KE_OPENAI_API_KEY=

# Optional OpenAlex federated scholarly discovery.
# Get a free API key from your OpenAlex account settings.
KE_OPENALEX_API_KEY=

# Optional Core API authentication for deployments that enable it.
KE_CORE_API_KEY=

# Optional Unpaywall polite-pool identity.
KE_UNPAYWALL_EMAIL=

# Optional model/runtime overrides.
KE_LLM_MODEL=
KE_OLLAMA_HOST=http://127.0.0.1:11434
